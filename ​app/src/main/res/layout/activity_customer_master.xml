<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD NEW CUSTOMER"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etCustName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Customer Name *"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etCustShop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Shop / Market Name"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etCustPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Mobile Number"
        android:inputType="phone"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etCustArea"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Area / Place"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etCustOpBal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Opening Balance (Old Pending Rs.)"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveCustomer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="SAVE CUSTOMER"
        android:backgroundTint="#2E7D32" />

</LinearLayout>
