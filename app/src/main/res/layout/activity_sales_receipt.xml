<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALES RECEIPT (BILL-WISE)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Mode Switch: NEW RECEIPT vs EDIT / DEL RECEIPT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnModeNewRec"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ NEW RECEIPT"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeEditRec"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="EDIT / DEL RECEIPT"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- EDIT / DELETE RECEIPT FILTER PANEL -->
        <LinearLayout
            android:id="@+id/layoutEditRecPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECT DATE &amp; CUSTOMER TO EDIT / DELETE RECEIPT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Receipt Date *" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText
                        android:id="@+id/etEditRecFilterDate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Customer Name *" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
                    <Spinner
                        android:id="@+id/spEditRecFilterCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:spinnerMode="dialog"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMatchingRecList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Row 1: Date & Receipt No -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Receipt Date *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <EditText
                    android:id="@+id/etRecDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Receipt No" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                <EditText
                    android:id="@+id/etRecNo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="REC-001"
                    android:textColor="#000000"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Searchable Customer Name -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Customer Name (Tap to Search) *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1B5E20" />
        <EditText
            android:id="@+id/etSearchCustomer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Tap here to search customer..."
            android:focusable="false"
            android:clickable="true"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- Live Customer Outstanding Banner -->
        <TextView
            android:id="@+id/tvCustOutstanding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Outstanding Balance: Rs. 0.00"
            android:background="#FFF9C4"
            android:textColor="#D84315"
            android:textStyle="bold"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginBottom="10dp" />

        <!-- Row 2: Received Amount & Discount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Received Amount (Rs) *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                <EditText
                    android:id="@+id/etRecAmount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Discount (Rs)" android:textSize="12sp" android:textStyle="bold" android:textColor="#D84315" />
                <EditText
                    android:id="@+id/etRecDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Total Settled Banner & Payment Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvRecTotalSettled"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Total Settled:\nRs. 0.00"
                android:background="#E8F5E9"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment Mode *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                <Spinner
                    android:id="@+id/spRecMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dialog"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bill-wise Pending Bills Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BILL-WISE PENDING DETAILS (Tap a bill to pay it directly)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="4dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="10dp">

            <TableLayout
                android:id="@+id/tlReceiptBills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#CFD8DC"
                android:padding="1dp">

                <TableRow android:background="#1B5E20">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bill No" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bill Amt" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This Rec+Disc" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Bal" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                </TableRow>
            </TableLayout>
        </HorizontalScrollView>

        <!-- Remarks -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Remarks / Notes" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
        <EditText
            android:id="@+id/etRecRemarks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Optional note..."
            android:textColor="#000000"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveReceipt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE RECEIPT &amp; UPDATE BILLS"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
