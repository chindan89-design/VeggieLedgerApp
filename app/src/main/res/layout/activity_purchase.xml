<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PURCHASE BILL ENTRY FORM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Row 1: Searchable Supplier & Payment Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Supplier Name (Type to Search) *" android:textSize="11sp" android:textStyle="bold" android:textColor="#1565C0" />
                <AutoCompleteTextView
                    android:id="@+id/actvSupplier"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Type supplier name..."
                    android:completionThreshold="1"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment Mode *" android:textSize="11sp" android:textStyle="bold" />
                <Spinner android:id="@+id/spPayMode" android:layout_width="match_parent" android:layout_height="48dp" android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Auto Bill No & Generated Batch ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto Bill No" android:textSize="11sp" android:textStyle="bold" />
                <EditText android:id="@+id/etBillNo" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Auto Bill No" android:background="@android:drawable/edit_text" android:padding="8dp" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stock Lot ID" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvGeneratedBatchId" android:layout_width="match_parent" android:layout_height="48dp" android:text="Auto Lot ID" android:gravity="center_vertical" android:background="#E3F2FD" android:textColor="#1565C0" android:textStyle="bold" android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Item Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E3F2FD"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Item *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1565C0" />
            <Spinner android:id="@+id/spItem" android:layout_width="match_parent" android:layout_height="48dp" android:background="@android:drawable/btn_dropdown" android:layout_marginBottom="8dp" />

            <!-- Bags & Bag Charge Side-by-Side (No Manual Weights!) -->
            <LinearLayout
                android:id="@+id/layoutOnionFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No. of Bags" android:textSize="12sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etBags" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0" android:inputType="number" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bag Charge / Bag (Rs)" android:textSize="12sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etBagRate" android:layout_width="match_parent" android:layout_height="48dp" android:text="10" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Net Kgs & Purchase Rate Side-by-Side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Net Kgs *" android:textSize="12sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etNetKgs" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0.0 Kgs" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate / Kg (Rs) *" android:textSize="12sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etRatePerKg" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0.00" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnAddItem" android:layout_width="match_parent" android:layout_height="46dp" android:text="+ ADD ITEM TO PURCHASE BILL" android:backgroundTint="#1976D2" />
        </LinearLayout>

        <TextView android:id="@+id/tvAddedItemsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No items added yet." android:background="#FFFFFF" android:padding="10dp" android:textSize="13sp" android:layout_marginBottom="10dp" />
        <TextView android:id="@+id/tvGrandTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grand Total: Rs. 0.00" android:textSize="18sp" android:textStyle="bold" android:textColor="#1565C0" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnSavePurchase" android:layout_width="match_parent" android:layout_height="52dp" android:text="SUBMIT PURCHASE &amp; CREATE STOCK" android:backgroundTint="#1565C0" />

    </LinearLayout>
</ScrollView>
