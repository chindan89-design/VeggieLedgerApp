<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Secondary Quick Strip Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B5E20"
        android:padding="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/stripSales"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ SALES"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stripPurchase"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ PURCHASE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stripReceipt"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ RECEIPT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stripPayment"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ PAY"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stripExpense"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="+ EXPENSE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stripHistory"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="HISTORY"
                android:textColor="#FFEB3B"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Live Summary Overview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veggie Mandi Overview"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDashCustDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Customer Pending: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:textColor="#2E7D32"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvDashSupDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Supplier Payable: Loading..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:textColor="#1565C0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvDashStockSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Stock Batches: Loading..."
            android:textSize="15sp"
            android:background="#FFF9C4"
            android:padding="16dp"
            android:textColor="#E65100"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip: Use the top menu strip (Masters, Entries, Reports) or the green quick bar above to navigate."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</LinearLayout>
