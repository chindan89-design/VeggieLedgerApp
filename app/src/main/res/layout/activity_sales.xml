<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/llSalesRootColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mode Toggle Bar: NEW BILL vs EDIT / DELETE BILL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnModeNewSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ NEW BILL"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeEditSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="EDIT / DELETE BILL"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSalesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALES ENTRY &amp; BILLING"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- EDIT / DELETE FILTER PANEL (Visible only in Edit Mode) -->
        <LinearLayout
            android:id="@+id/layoutEditSalesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filter Bills to Edit or Delete:"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.9"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bill Date"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etEditSalesFilterDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spEditSalesFilterCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMatchingSalesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- One-Click Excel / CSV Import Button -->
        <Button
            android:id="@+id/btnImportSalesCsv"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="IMPORT SALES (EXCEL / CSV)"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Auto-generated hidden Bill No & legacy PayMode reference -->
        <EditText
            android:id="@+id/etSalesBillNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SAL-001"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spSalesPayMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- CLEAN TABLE LAYOUT FOR SALES INPUTS (1 to 6) -->
        <TableLayout
            android:id="@+id/tlSalesEntryForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:background="#BDBDBD"
            android:padding="1dp"
            android:layout_marginBottom="10dp">

            <!-- 1. Bill Date -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="1. Bill Date"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#F1F8E9"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </TableRow>

            <!-- 2. Select Item -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="2. Select Item"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#F1F8E9"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <Spinner
                        android:id="@+id/spSalesItem"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>
            </TableRow>

            <!-- 3. Select Stock (Injected in Kotlin right after row index 1 -> row index 2) -->

            <!-- 4. Select Name -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="4. Select Name"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#F1F8E9"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Tap to select customer..."
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSalesCustBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Previous Balance: Rs. 0.00"
                        android:background="#FFF9C4"
                        android:textColor="#D84315"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:padding="6dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </TableRow>

            <!-- 5A. Bags (Shown for Other than Coconut) -->
            <TableRow
                android:id="@+id/trSalesBags"
                android:background="#BDBDBD">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Bags"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#FFFDE7"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesBags"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="0"
                        android:inputType="number"
                        android:textColor="#000000"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </TableRow>

            <!-- 5B. Kgs -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Kgs"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#F1F8E9"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesKgs"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </TableRow>

            <!-- 5C. Rate -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Rate"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#F1F8E9"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesRate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </TableRow>

            <!-- 5D. Bag Rate (Shown for Other than Coconut) -->
            <TableRow
                android:id="@+id/trSalesBagRate"
                android:background="#BDBDBD">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Bag Rate"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#FFFDE7"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <EditText
                        android:id="@+id/etSalesBagCharge"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </TableRow>

            <!-- 5E. Weigh Coolie (Injected in Kotlin for Other than Coconut) -->

            <!-- 5F. Amount / Total Amount -->
            <TableRow android:background="#BDBDBD">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Amount"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:background="#FFF9C4"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:layout_margin="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:padding="6dp"
                    android:layout_margin="1dp">

                    <TextView
                        android:id="@+id/tvLineAmountPreview"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Rs. 0.00"
                        android:gravity="center_vertical"
                        android:textColor="#D84315"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingStart="8dp" />
                </LinearLayout>
            </TableRow>

            <!-- 6. Pay Mode (Injected in Kotlin as single-line Cash | GPay | Credit + Cash Payer) -->

        </TableLayout>

        <!-- Step A: Add Entered Item Row into Grid View -->
        <Button
            android:id="@+id/btnAddSalesItem"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="+ ADD ITEM TO BILL"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Step B: Grid View of Added Items (Must have items before saving bill) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="10dp">

            <TableLayout
                android:id="@+id/tlSalesItemsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#CFD8DC"
                android:padding="1dp">

                <TableRow android:background="#1B5E20">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Item" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bags" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kgs" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BagChg" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Del" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="center" />
                </TableRow>
            </TableLayout>
        </HorizontalScrollView>

        <!-- Step C: Bottom Summary & Action Buttons -->
        <TextView
            android:id="@+id/tvSalesGrandTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grand Total: Rs. 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveSalesBill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE SALES BILL"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- SEND JPG BILL button is appended right below btnSaveSalesBill at the bottom -->

    </LinearLayout>
</ScrollView>
