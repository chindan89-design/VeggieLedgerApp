<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Mode Toggle Bar: NEW BILL vs EDIT / DELETE BILL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnModeNewSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ NEW BILL"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeEditSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="EDIT / DELETE BILL"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSalesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALES ENTRY &amp; BILLING"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- EDIT / DELETE FILTER PANEL (Visible only in Edit Mode) -->
        <LinearLayout
            android:id="@+id/layoutEditSalesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filter Bills to Edit or Delete:"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:orientation="vertical" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bill Date" android:textSize="11sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etEditSalesFilterDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customer" android:textSize="11sp" android:textStyle="bold" />
                    <Spinner
                        android:id="@+id/spEditSalesFilterCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llMatchingSalesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- One-Click Excel / CSV Import Button -->
        <Button
            android:id="@+id/btnImportSalesCsv"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="IMPORT SALES (EXCEL / CSV)"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Row 1: Date & Bill No -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Bill Date *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <EditText
                    android:id="@+id/etSalesDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bill No *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                <EditText
                    android:id="@+id/etSalesBillNo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="SAL-001"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Customer Search & Pay Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="8dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Customer (Tap Search) *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <EditText
                    android:id="@+id/etSalesCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Tap to select..."
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pay Mode *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                <Spinner
                    android:id="@+id/spSalesPayMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customer Balance Banner -->
        <TextView
            android:id="@+id/tvSalesCustBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Previous Balance: Rs. 0.00"
            android:background="#FFF9C4"
            android:textColor="#D84315"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- ITEM ENTRY CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Select Item *" android:textSize="12sp" android:textStyle="bold" android:textColor="#1B5E20" />
            <Spinner
                android:id="@+id/spSalesItem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="8dp" />

            <!-- Bags, Net Kgs, Rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bags" android:textSize="11sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etSalesBags"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="0"
                        android:inputType="number"
                        android:textColor="#000000"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginHorizontal="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Net Kgs *" android:textSize="11sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etSalesKgs"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate (Rs) *" android:textSize="11sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etSalesRate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bag Charge & Line Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bag Charge (Rs)" android:textSize="11sp" android:textStyle="bold" />
                    <EditText
                        android:id="@+id/etSalesBagCharge"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLineAmountPreview"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Item Amt: Rs. 0.00"
                    android:gravity="center_vertical"
                    android:textColor="#1B5E20"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:paddingStart="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAddSalesItem"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="+ ADD ITEM TO BILL"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BILL ITEMS DATA GRID -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="10dp">

            <TableLayout
                android:id="@+id/tlSalesItemsGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#CFD8DC"
                android:padding="1dp">

                <TableRow android:background="#1B5E20">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Item" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bags" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kgs" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BagChg" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Del" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="center" />
                </TableRow>
            </TableLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvSalesGrandTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grand Total: Rs. 0.00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveSalesBill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE SALES BILL"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
