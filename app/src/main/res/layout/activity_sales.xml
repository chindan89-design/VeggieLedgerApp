<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSalesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALES BILL ENTRY FORM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Mode Switch: NEW BILL vs EDIT BILL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnModeNewSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="+ NEW BILL"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnModeEditSales"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="EDIT BILL"
                android:backgroundTint="#78909C"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- EDIT FILTER PANEL (Visible only when EDIT BILL is selected) -->
        <LinearLayout
            android:id="@+id/layoutEditSalesPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECT DATE &amp; CUSTOMER TO EDIT BILL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Bill Date *" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText
                        android:id="@+id/etEditFilterDate"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:background="@android:drawable/edit_text"
                        android:padding="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Customer Name *" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
                    <Spinner
                        android:id="@+id/spEditFilterCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:spinnerMode="dialog"
                        android:background="@android:drawable/btn_dropdown" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a bill below to load &amp; edit:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/llMatchingBillsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Row 1: Date Picker & Select Item Dropdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Sales Date *" android:textSize="11sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <EditText
                    android:id="@+id/etSalesDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Select Item *" android:textSize="11sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <Spinner
                    android:id="@+id/spSalesItem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dialog"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Searchable Customer & Payment Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Customer Name (Search) *" android:textSize="11sp" android:textStyle="bold" android:textColor="#1B5E20" />
                <AutoCompleteTextView
                    android:id="@+id/actvCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Type customer..."
                    android:completionThreshold="1"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment Mode *" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
                <Spinner
                    android:id="@+id/spSalesPayMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dialog"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Auto Bill No -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bill No" android:textSize="11sp" android:textStyle="bold" android:textColor="#333333" />
        <EditText android:id="@+id/etSalesBillNo" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Auto Bill No" android:textColor="#000000" android:background="@android:drawable/edit_text" android:padding="8dp" android:layout_marginBottom="10dp" />

        <!-- Item Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Supplier Stock Lot ID *" android:textSize="12sp" android:textStyle="bold" android:textColor="#2E7D32" />
            <Spinner
                android:id="@+id/spSupplierBatch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:spinnerMode="dialog"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLiveStockBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Stock: Select Lot ID above"
                android:background="#FFF9C4"
                android:textColor="#E65100"
                android:textStyle="bold"
                android:textSize="13sp"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Bags & Bag Charge Side-by-Side (Onion-க்கு மட்டும்) -->
            <LinearLayout
                android:id="@+id/layoutSalesOnion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No. of Bags" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText android:id="@+id/etSalesBags" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0" android:textColor="#000000" android:inputType="number" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bag Charge / Bag (Rs)" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText android:id="@+id/etSalesBagRate" android:layout_width="match_parent" android:layout_height="48dp" android:text="10" android:textColor="#000000" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Net Kgs & Sales Rate Side-by-Side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Net Kgs *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText android:id="@+id/etSalesNetKgs" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0.0 Kgs" android:textColor="#000000" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sales Rate / Kg (Rs) *" android:textSize="12sp" android:textStyle="bold" android:textColor="#333333" />
                    <EditText android:id="@+id/etSalesRatePerKg" android:layout_width="match_parent" android:layout_height="48dp" android:hint="0.00" android:textColor="#000000" android:inputType="numberDecimal" android:background="@android:drawable/edit_text" android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnAddSalesItem" android:layout_width="match_parent" android:layout_height="46dp" android:text="+ ADD ITEM TO SALES BILL" android:backgroundTint="#2E7D32" android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Added Items Grid / Table View (with Delete option for easy editing) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:layout_marginBottom="10dp">

            <TableLayout
                android:id="@+id/tlSalesGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#CFD8DC"
                android:padding="1dp">

                <TableRow android:background="#1B5E20">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Item" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lot ID" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bags" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Net Kgs" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rate" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Del" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="8dp" android:gravity="center" />
                </TableRow>
            </TableLayout>
        </HorizontalScrollView>

        <TextView android:id="@+id/tvSalesGrandTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Grand Total: Rs. 0.00" android:textSize="18sp" android:textStyle="bold" android:textColor="#1B5E20" android:layout_marginBottom="12dp" />
        <Button android:id="@+id/btnSaveSalesBill" android:layout_width="match_parent" android:layout_height="52dp" android:text="SUBMIT SALES BILL &amp; UPDATE STOCK" android:backgroundTint="#1B5E20" android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
